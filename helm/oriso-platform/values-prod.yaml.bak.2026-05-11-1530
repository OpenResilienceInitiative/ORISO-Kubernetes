global:
  environment: prod
  namespace: caritas
  domain: oriso.org
  imageRegistry: ""
  ingress:
    className: nginx
    tls:
      enabled: true
      secretName: wildcard-tls

namespace:
  create: false

externalSecrets:
  enabled: false

bootstrapSecrets:
  enabled: true
  mariadb:
    rootPassword: "Expertflow123"
    database: "oriso"
    user: "oriso"
    password: "Expertflow123"
  rabbitmq:
    user: "admin"
    password: "admin"
  redis:
    password: "Expertflow123"

bootstrapPvc:
  enabled: true
  storageClass: local-path
  mongodb:
    size: 20Gi
  redis:
    size: 10Gi
  matrix:
    size: 20Gi


mariadb:
  enabled: true
  image:
    repository: mariadb
    tag: "10.11"
    pullPolicy: IfNotPresent
  livenessProbe:
    exec:
      command:
        - sh
        - -c
        - mysqladmin ping -h 127.0.0.1 -uroot -p"$MYSQL_ROOT_PASSWORD"
    initialDelaySeconds: 30
    periodSeconds: 10
    timeoutSeconds: 5
    successThreshold: 1
    failureThreshold: 6
  readinessProbe:
    exec:
      command:
        - sh
        - -c
        - mysql -h 127.0.0.1 -uroot -p"$MYSQL_ROOT_PASSWORD" -e 'SELECT 1;'
    initialDelaySeconds: 10
    periodSeconds: 5
    timeoutSeconds: 3
    successThreshold: 1
    failureThreshold: 3


mongodb:
  enabled: true
  image:
    repository: mongo
    tag: "6.0"
    pullPolicy: IfNotPresent

redis:
  enabled: true
  image:
